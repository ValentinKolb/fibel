{
  "name": "@k2b/fibel",
  "version": "0.2.1",
  "description": "Config-first documentation app for Markdown, i18n, search, and no-flicker themes.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "homepage": "https://fibel.dev",
  "bin": {
    "fibel": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./plugins": "./src/plugins/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts dev",
    "build": "bun run src/cli.ts build",
    "start": "bun dist/server.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@k2b/nessi": "^0.10.0",
    "@k2b/stdlib": "^0.17.0",
    "@k2b/sync": "^5.7.0",
    "bun-plugin-tailwind": "^0.1.2",
    "marked": "^16.4.1",
    "tailwindcss": "^4.1.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "Valentin Kolb",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k2b-dev/fibel.git"
  },
  "bugs": {
    "url": "https://github.com/k2b-dev/fibel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "docs",
    "documentation",
    "markdown",
    "i18n",
    "search",
    "fetch",
    "tailwind"
  ],
  "files": [
    "src/**/*",
    "skills/**/*",
    "README.md",
    "LICENSE"
  ]
}
